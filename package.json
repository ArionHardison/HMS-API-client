{
  "name": "@arionhardison/wizard-api-client",
  "version": "1.16.0",
  "description": "TypeScript client library for HMS API with Five-Step Wizard integration",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:vue",
    "build:lib": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:vue": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean && npm run generate:lib",
    "generate:lib": "npm run generate:types",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:contract": "vitest run src/__tests__/contract",
    "type-check": "vue-tsc --noEmit",
    "types:test-d": "tsc -p tsconfig.typecheck.json",
    "types:check": "npm run generate:types && git diff --exit-code src/generated && npm run types:test-d",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "prepublishOnly": "npm run build",
    "generate": "npm run generate:types && npm run generate:docs",
    "generate:normalize": "node scripts/dedupe-operation-ids.mjs",
    "generate:types": "npm run generate:normalize && openapi-typescript ./spec/openapi.json -o ./src/generated/api-types.ts && npm run generate:operation-index",
    "generate:operation-index": "node scripts/generate-operation-index.mjs",
    "generate:docs": "npm run docs:api && npm run docs:client",
    "docs:api": "redoc-cli build ./spec/openapi.json --output docs/api.html",
    "docs:client": "typedoc src/api --out docs/client",
    "docs:serve": "npx http-server docs -p 8080",
    "sync:check": "npm run types:check",
    "sync:auto": "npm run generate && npm run types:check && npm run test:contract",
    "version:check": "node scripts/check-breaking-changes.js",
    "migration:generate": "node scripts/generate-migration-guide.js"
  },
  "keywords": [
    "api",
    "client",
    "typescript",
    "hms",
    "wizard",
    "five-step-wizard",
    "healthcare",
    "education"
  ],
  "author": "HMS Team",
  "license": "MIT",
  "dependencies": {
    "@vueuse/core": "^10.5.0",
    "@vueuse/integrations": "^10.5.0",
    "axios": "^1.16.0",
    "form-data": "^4.0.6",
    "zod": "^3.23.0"
  },
  "overrides": {
    "form-data": "$form-data",
    "axios": "$axios"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.50.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "msw": "^2.14.3",
    "openapi-types": "^12.1.3",
    "openapi-typescript": "^6.7.0",
    "openapi-typescript-codegen": "^0.25.0",
    "pinia": "^2.1.7",
    "redoc-cli": "^0.13.21",
    "swagger-jsdoc": "^6.2.8",
    "ts-jest": "^29.1.0",
    "typedoc": "^0.25.0",
    "typescript": "~5.4.5",
    "undici": "^6.25.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "vue-tsc": "^1.8.0"
  },
  "peerDependencies": {
    "pinia": "^2.1.0 || ^3.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArionHardison/HMS-API-client.git"
  },
  "bugs": {
    "url": "https://github.com/ArionHardison/HMS-API-client/issues"
  },
  "homepage": "https://github.com/ArionHardison/HMS-API-client#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
