{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "outDir": "./dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmitOnError": false,
    "skipLibCheck": true
  },
  "include": [
    "src/vue3/**/*",
    "src/composables/**/*",
    "src/stores/**/*",
    "src/router/**/*"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts", "dist"]
}
